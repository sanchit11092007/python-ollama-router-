# ══════════════════════════════════════════════════════════════════════════════
# Agent OTG — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
# Edit this file to swap models, change ports, or tune RAG without touching code.
# Restart ask.py or the uvicorn server after making any changes here.
#
# All settings have safe defaults if this file is missing.

# ── Models (must match `ollama list`) ─────────────────────────────────────────
# Swap any model name here to instantly change which model handles that role.
CODER_MODEL=qwen2.5-coder:latest
MAIN_MODEL=qwen2.5:7b
COMPLEX_MODEL=qwen2.5:14b
FAST_MODEL=qwen2.5:7b
IMAGE_MODEL=qwen2.5vl:7b

# ── RAG / Embeddings ──────────────────────────────────────────────────────────
RAG_LLM_MODEL=qwen2.5:7b
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_VISION_MODEL=qwen2.5vl:7b

# RAG retrieval tuning (higher = better recall, slightly slower)
RAG_TOP_K=8
RAG_FETCH_K=25
RAG_MAX_CONTEXT_DOCS=8
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# RAG features (true/false)
RAG_ENABLE_MULTI_QUERY=true
RAG_ENABLE_SEMANTIC_SPLITTER=false
# Query expansion: rewrites user query into 2 variants before retrieval (boosts recall)
RAG_QUERY_EXPANSION=true

# ── Ollama Server ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agent_otg
DB_USER=postgres
DB_PASSWORD=Sanc@2007

# ── Smart Routing ────────────────────────────────────────────────────────────
# When true, Agent OTG auto-detects RAG/agent intent without needing /rag or /agent
SMART_ROUTING_ENABLED=true
DIRECT_14B_MODE=true
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1536
MEMORY_MAX_TURNS=6
MEMORY_MAX_CHARS=12000
IMAGE_GEN_MODEL=stabilityai/sd-turbo
IMAGE_GEN_LOCAL_ONLY=false
IMAGE_GEN_SIZE=512

# ── App Info ──────────────────────────────────────────────────────────────────
APP_VERSION=2.1.0
